#!/bin/sh
# Stand-in for the Infisical CLI so the shell integration can be tested with no
# credentials, no network, and a fixed set of secrets.
#
#   STUB_INFISICAL_FAIL=1      make `export` fail, as an unreachable server would
#   STUB_INFISICAL_EXPIRED=1   make `login status` fail, as an expired session
#                              would, and have `export` reproduce the real CLI's
#                              behaviour of writing an interactive picker to
#                              stdout instead of JSON
#   STUB_INFISICAL_CALLS       file to append one line per call, for asserting
#                              that a fresh cache does not re-fetch
#   STUB_INFISICAL_ENVS        space-separated environments that exist; any
#                              other --env 404s the way the real server does.
#                              Unset means every environment exists.

[ -n "${STUB_INFISICAL_CALLS:-}" ] && echo "$*" >> "$STUB_INFISICAL_CALLS"

# Pulled out because the export branch needs it both to decide whether the
# environment exists and to vary what it returns.
requested_env=default
for arg in "$@"; do
  case "$arg" in
    --env=*) requested_env="${arg#--env=}" ;;
  esac
done

case "$1 $2" in
  "login status")
    if [ "${STUB_INFISICAL_EXPIRED:-0}" = "1" ]; then
      echo "x Failed to authenticate: session expired"
      exit 1
    fi
    echo "Authenticated"
    exit 0
    ;;
esac

case "$1" in
  export)
    if [ "${STUB_INFISICAL_EXPIRED:-0}" = "1" ]; then
      # Deliberately on stdout, and deliberately not JSON: this is what fed the
      # jq parse error the session guard now prevents.
      echo "? Select your hosting option:"
      echo "  > Infisical Cloud (US Region)"
      exit 1
    fi
    if [ "${STUB_INFISICAL_FAIL:-0}" = "1" ]; then
      echo "stub: simulated unreachable server" >&2
      exit 1
    fi

    # A missing environment is a 404 on stderr and a non-zero exit, exactly as
    # the real server answers for an environment slug that does not exist.
    if [ -n "${STUB_INFISICAL_ENVS:-}" ]; then
      found=0
      for e in $STUB_INFISICAL_ENVS; do
        [ "$e" = "$requested_env" ] && found=1
      done
      if [ "$found" = "0" ]; then
        echo "Message: Folder with path '/' in environment '$requested_env' was not found." >&2
        echo "  • Unable to fetch secrets" >&2
        exit 1
      fi
    fi

    # Tag one secret with the environment so a test can prove which one won.
    sed "s/__ENV__/$requested_env/g" /opt/test/secrets.json
    ;;
  *)
    echo "stub: unsupported command: $*" >&2
    exit 1
    ;;
esac
